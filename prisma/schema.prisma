generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EventLog {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}
